# Supabase — customer-facing auth + database (see /supabase/migrations).
# Project Settings -> API in your Supabase dashboard. REACT_APP_SUPABASE_ANON_KEY
# is the public "anon" key — safe for frontend use, RLS enforces access control.
# NEVER put the service_role key in this file or anywhere in frontend code.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the legacy Express API (see the separate /backend project). Not
# used by the live app anymore — the Supabase migration is complete
# (auth, menu, orders, and admin all run on Supabase now; see
# backend/README.md). This only matters if you're running frontend/src/api/*
# directly against the reference Express server for comparison — the app
# itself never imports those files. Safe to leave unset.
# Local dev, if you want it:
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Production example, if the Express server is ever deployed somewhere
# (Render, Railway, Fly.io, a VPS, etc. — CRA is a static build, so this
# can't run as a Vercel serverless function; it needs its own always-on host):
# REACT_APP_API_BASE_URL=https://api.yourdomain.com/api
