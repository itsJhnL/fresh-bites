# Supabase — customer-facing auth + database (see /supabase/migrations).
# Project Settings -> API in your Supabase dashboard. REACT_APP_SUPABASE_ANON_KEY
# is the public "anon" key — safe for frontend use, RLS enforces access control.
# NEVER put the service_role key in this file or anywhere in frontend code.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the Fresh Bites API (see the separate /backend project).
# As of the Supabase Auth migration this is no longer used for customer
# login/signup — it's kept only for the parts of the app not yet migrated
# (order creation, the admin panel). See frontend/src/api/authApi.js and
# backend/README.md for the current status of this transition.
# Local dev:
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Production example, once the Express server is deployed somewhere (Render,
# Railway, Fly.io, a VPS, etc. — CRA is a static build, so this can't run as a
# Vercel serverless function; it needs its own always-on host):
# REACT_APP_API_BASE_URL=https://api.yourdomain.com/api
