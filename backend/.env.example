# Postgres connection string (Neon / Supabase both give you this directly)
# Example Neon:     postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Example Supabase: postgres://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/fresh_bites

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long access tokens last
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

PORT=5000
NODE_ENV=development
